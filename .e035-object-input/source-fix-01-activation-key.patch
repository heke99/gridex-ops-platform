+it('persists the actual activated profile tuple from the real runtime rather than its semantic alias', async () => {
+  const { approvalFixture } = await import('./helpers/receivedSourceObjectFixture')
+  const { resolveCanonicalRuntimeDecisionWithRegistry } = await import('@/lib/ediel/core/runtimeDecision')
+  const { buildReceivedSourceValidationEvidence } = await import('@/lib/ediel/core/receivedSourceValidationEvidence')
+  const db = z01Evidence({ messageCode: 'Z04', canonicalDirection: 'inbound' })
+  db.profile_key = 'PRODAT:Z04:L:26.A:r3'
+  mocks.rpc.mockResolvedValue({ data: [db], error: null })
+  const { message } = approvalFixture()
+  const decision = await resolveCanonicalRuntimeDecisionWithRegistry(message)
+  expect(decision.applicationDecision).toBe('accepted')
+  const result = buildReceivedSourceValidationEvidence({ original: message, validated: message, resolvedCompanyId: message.company_id, decision })
+  expect(result).not.toBeNull()
+  expect(JSON.parse(result!.factsText).rulePackEvidence).toEqual({ profileKey: db.profile_key, messageProfileId: db.message_profile_id, rulePackId: db.rule_pack_id, sourceHash: db.source_hash })
