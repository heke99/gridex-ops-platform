+it('preserves the activated DB profile identity separately from the normative policy name', async () => {
+  mocks.rpc.mockResolvedValue({ data: [z01Evidence()], error: null })
+  const result = await resolveCanonicalRulePack({ family: 'PRODAT', messageCode: 'Z01', transactionSubtype: 'L', direction: 'outbound', businessDate: '2026-09-03' })
