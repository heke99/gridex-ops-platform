{"preSha256":"69ada64839584b3576e9b57471143f1ce23c0e87bdc724f9f2261ed15fdfa85b","postSha256":"4ab0c60bd5688e9653927491981f779b374a3a85600d8a87e050ac67f15a15ca","hunks":[{"preStart":40538,"preCount":0,"preSha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","postStart":40538,"postCount":45,"postSha256":"69a9481c21a36cedcfce32aa609bba41a86b1abd5746a5c09c2fabc540bb54fd","preLines":[],"postLines":["  -- G-3 (20261024110000): a readiness revalidation always evaluates the company's current snapshot, so an older","  -- unclaimed revalidate job is redundant once a newer one of the same company is completed, processing or claimable.","  -- At most100 rows are closed per call; logical exclusion below does not wait","  -- for all stale rows to be physically closed. Rows and audit evidence remain.","  with superseded as (","    select stale.id, newer.id as newer_id, newer.idempotency_key as newer_key","    from public.company_provisioning_jobs stale","    cross join lateral (","      select candidate.id, candidate.idempotency_key","      from public.company_provisioning_jobs candidate","      where candidate.company_id = stale.company_id","        and candidate.job_key = 'ediel_readiness_revalidate'","        and (candidate.created_at, candidate.id) > (stale.created_at, stale.id)","        and (candidate.status in ('completed','processing')","             or (candidate.status in ('pending','retry') and candidate.attempt_count < candidate.max_attempts))","      order by candidate.created_at desc, candidate.id desc","      limit 1","    ) newer","    where stale.job_key = 'ediel_readiness_revalidate'","      and stale.status in ('pending','retry')","      and stale.attempt_count < stale.max_attempts","    order by stale.created_at,stale.id","    for update of stale skip locked","    limit 100","  )","  update public.company_provisioning_jobs stale","  set status = 'completed',","      completed_at = now(),","      last_error_code = 'superseded_by_newer_revalidation',","      last_error_message = null,","      last_error_details = jsonb_build_object(","        'superseded_by_job_id', superseded.newer_id,","        'superseded_by_idempotency_key', superseded.newer_key,","        'superseded_at', now()),","      locked_at = null,","      locked_by = null,","      lease_token = null,","      updated_at = now()","  from superseded","  where stale.id = superseded.id","    and stale.status in ('pending','retry');","","  -- G-3 (20261024110000): one oldest job per company precedes its second;","  -- durable last_turn rotates companies across calls even when p_limit is smaller","  -- than the company count. Clock ties and completed-row history do not reset it."]},{"preStart":40539,"preCount":1,"preSha256":"0511338d539a5a70ba59d9f02f1a09e4a640a784db36e2cf0ab9a86fc7207d16","postStart":40584,"postCount":32,"postSha256":"7bdd8f3b7564fcf692465cb4c5dab8d63bd2b45f5712755de447c94d585c6600","preLines":["  with candidates as ("],"postLines":["  with eligible_companies as materialized (","    select company.id as company_id,","      coalesce((select max(served.claim_turn) from public.company_provisioning_jobs served","        where served.company_id=company.id),0) as last_turn","    from public.companies company","    where company.status in ('onboarding','active')","      and company.id in (","        select pending.company_id from public.company_provisioning_jobs pending","        where pending.status in ('pending','retry')","          and pending.available_at <= now()","          and pending.attempt_count < pending.max_attempts)","      and (select decision.allowed","           from public.canonical_tenant_operation_decision(company.id, 'tenant.provisioning.execute') decision","           limit 1)","  ), ranked as (","    select job.id,","           eligible.last_turn,","           job.available_at,","           job.created_at,","           row_number() over (partition by job.company_id order by job.available_at, job.created_at, job.id) as company_rank","    from public.company_provisioning_jobs job","    join eligible_companies eligible on eligible.company_id = job.company_id","    where job.status in ('pending','retry')","      and job.available_at <= now()","      and job.attempt_count < job.max_attempts","      and not (job.job_key='ediel_readiness_revalidate' and exists(","        select 1 from public.company_provisioning_jobs newer","        where newer.company_id=job.company_id and newer.job_key='ediel_readiness_revalidate'","          and (newer.created_at,newer.id)>(job.created_at,job.id)","          and (newer.status in('completed','processing')","            or (newer.status in('pending','retry') and newer.attempt_count<newer.max_attempts))))","  ), candidates as ("]},{"preStart":40542,"preCount":0,"preSha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","postStart":40618,"postCount":1,"postSha256":"325926735c104453b69a6929f52c2a44a9ed52d05a6bd9a62637943f9b102a9b","preLines":[],"postLines":["    join ranked fair on fair.id = job.id"]},{"preStart":40547,"preCount":4,"preSha256":"bdc04dad83c0e09d10bf02468d285ddb0f58cb8f3c0145b4f0c1da99b55e44a7","postStart":40624,"postCount":1,"postSha256":"412caa727e8d7d468888132373ce95219713510cbbb22a555f268b5c56b0b49f","preLines":["      and (select decision.allowed","           from public.canonical_tenant_operation_decision(job.company_id, 'tenant.provisioning.execute') decision","           limit 1)","    order by job.available_at, job.created_at"],"postLines":["    order by fair.company_rank, fair.last_turn, fair.available_at, fair.created_at, job.id"]},{"preStart":40562,"preCount":0,"preSha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","postStart":40636,"postCount":1,"postSha256":"12f189d2d5a683d4abffe6bd7caee07404e43442bf1c9579000ca079b83a9f76","preLines":[],"postLines":["        claim_turn = nextval('public.gridex_provisioning_claim_turn_seq'::regclass),"]},{"preStart":116369,"preCount":0,"preSha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","postStart":116444,"postCount":1,"postSha256":"61e920057d59cb4e4cc3c15a4d389b5ed399a12e6523a93e48c3a73420267c6c","preLines":[],"postLines":["    claim_turn bigint DEFAULT 0 NOT NULL,"]},{"preStart":125959,"preCount":0,"preSha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","postStart":126035,"postCount":17,"postSha256":"de09d556894635bcf84edf7181a8b6625d732b3380dad3945ae8fbd248e459e8","preLines":[],"postLines":["--","-- Name: gridex_provisioning_claim_turn_seq; Type: SEQUENCE; Schema: public; Owner: -","--","","CREATE SEQUENCE public.gridex_provisioning_claim_turn_seq","    START WITH 1","    INCREMENT BY 1","    NO MINVALUE","    NO MAXVALUE","    CACHE 1;","","--","-- Name: gridex_provisioning_claim_turn_seq; Type: SEQUENCE OWNED BY; Schema: public; Owner: -","--","","ALTER SEQUENCE public.gridex_provisioning_claim_turn_seq OWNED BY public.company_provisioning_jobs.claim_turn;",""]},{"preStart":141402,"preCount":0,"preSha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","postStart":141495,"postCount":12,"postSha256":"6c3d821ec09af5de6eea6e710c9742fa1f7ef2c836f1162f730baa9d258e4d08","preLines":[],"postLines":["--","-- Name: company_provisioning_jobs_company_claim_turn_idx; Type: INDEX; Schema: public; Owner: -","--","","CREATE INDEX company_provisioning_jobs_company_claim_turn_idx ON public.company_provisioning_jobs USING btree (company_id, claim_turn DESC);","","--","-- Name: company_provisioning_jobs_revalidate_newer_idx; Type: INDEX; Schema: public; Owner: -","--","","CREATE INDEX company_provisioning_jobs_revalidate_newer_idx ON public.company_provisioning_jobs USING btree (company_id, created_at DESC, id DESC) INCLUDE (status, attempt_count, max_attempts, idempotency_key) WHERE (job_key = 'ediel_readiness_revalidate'::text);",""]}]}
