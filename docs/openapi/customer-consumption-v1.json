{
  "openapi": "3.1.0",
  "info": {
    "title": "Gridex Customer Consumption additive contract",
    "version": "2026-11-13.1",
    "description": "Independent supplement; existing Customer Portal/Website releases remain immutable. Confirmed supply starts require both actual_start_date and canonical market_start_at; missing authority fails closed. Inclusive actual_end_date is converted to next local midnight; market instants and planned end may only restrict it. Each authority read is complete up to 1000 rows or fails closed. Meter pages preserve scanned cursors after supply-window filtering. Requests are limited to 32 physical days. Clients must follow all has_more cursors, discard non-current revisions, and reject overlapping current series."
  },
  "servers": [
    {
      "url": "https://app.gridex.se"
    }
  ],
  "paths": {
    "/api/v1/customer/consumption/sites": {
      "get": {
        "operationId": "getApiV1CustomerConsumptionSites",
        "description": "Requires the ordinary installed service API client, both customer_sites.read and customer_metering.read, and a strictly linked portal identity. No request parameter can select a customer.",
        "security": [
          {
            "apiKey": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 2048
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Complete bounded page; UTC intervals are half-open.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              },
              "X-Gridex-Consumption-Version": {
                "schema": {
                  "type": "string",
                  "const": "2026-11-13.1"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SitesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or repeated parameter/cursor.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              },
              "X-Gridex-Consumption-Version": {
                "schema": {
                  "type": "string",
                  "const": "2026-11-13.1"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid service credentials.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              },
              "X-Gridex-Consumption-Version": {
                "schema": {
                  "type": "string",
                  "const": "2026-11-13.1"
                }
              }
            }
          },
          "403": {
            "description": "Scope, installation or verified customer binding denied.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              },
              "X-Gridex-Consumption-Version": {
                "schema": {
                  "type": "string",
                  "const": "2026-11-13.1"
                }
              }
            }
          },
          "404": {
            "description": "Facility does not belong to the resolved customer.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              },
              "X-Gridex-Consumption-Version": {
                "schema": {
                  "type": "string",
                  "const": "2026-11-13.1"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              },
              "X-Gridex-Consumption-Version": {
                "schema": {
                  "type": "string",
                  "const": "2026-11-13.1"
                }
              }
            }
          },
          "503": {
            "description": "Authority or canonical data unavailable/incomplete; no customer data.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              },
              "X-Gridex-Consumption-Version": {
                "schema": {
                  "type": "string",
                  "const": "2026-11-13.1"
                }
              }
            }
          }
        },
        "x-required-scopes": [
          "customer_sites.read",
          "customer_metering.read"
        ],
        "x-scope-mode": "all",
        "x-rate-limit-class": "read",
        "x-idempotency-required": false,
        "x-cache-policy": "no-store",
        "x-public-id-policy": "opaque-references"
      }
    },
    "/api/v1/customer/consumption/metering-values": {
      "get": {
        "operationId": "getApiV1CustomerConsumptionMeteringValues",
        "description": "Requires the ordinary installed service API client, both customer_sites.read and customer_metering.read, and a strictly linked portal identity. No request parameter can select a customer.",
        "security": [
          {
            "apiKey": []
          }
        ],
        "parameters": [
