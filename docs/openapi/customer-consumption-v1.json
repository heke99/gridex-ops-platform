  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "Page": {
        "type": "object",
        "properties": {
          "has_more": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "const": 0
          },
          "returned": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "has_more",
          "next_cursor"
        ],
        "additionalProperties": false
      },
      "DeliveryWindow": {
        "type": "object",
        "properties": {
          "facility_reference": {
            "type": "string"
          },
          "metering_point_reference": {
            "type": "string"
          },
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "facility_reference",
          "metering_point_reference",
          "from",
          "to"
        ],
        "additionalProperties": false
      },
      "Site": {
        "type": "object",
        "required": [
          "facility_reference",
          "facility_id"
        ],
        "properties": {
          "facility_reference": {
            "type": "string"
          },
          "facility_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      },
      "MeteringPoint": {
        "type": "object",
        "required": [
          "metering_point_reference",
          "facility_reference"
        ],
        "properties": {
          "metering_point_reference": {
            "type": "string"
          },
          "facility_reference": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "MeteringValue": {
        "type": "object",
        "properties": {
          "metering_value_reference": {
            "type": "string"
          },
          "metering_point_reference": {
            "type": "string"
          },
          "period_start": {
            "type": "string",
            "format": "date-time"
          },
          "period_end": {
            "type": "string",
            "format": "date-time"
          },
          "resolution": {
            "type": [
              "string",
              "null"
            ]
          },
          "quantity_kwh": {
            "type": [
              "number",
              "null"
            ]
          },
          "quality_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "revision_status": {
            "type": "string",
            "enum": [
              "current",
              "replaced",
              "superseded",
              "void"
            ]
          },
          "direction": {
            "type": "string",
            "enum": [
              "consumption"
            ]
          },
          "unit": {
            "type": "string",
            "enum": [
              "kWh"
            ]
          }
        },
        "required": [
          "metering_value_reference",
          "metering_point_reference",
          "period_start",
          "period_end",
          "resolution",
          "quantity_kwh",
          "quality_status",
          "status",
          "created_at",
          "revision_status",
          "direction",
          "unit"
        ],
        "additionalProperties": false
      },
      "SitesResponse": {
        "type": "object",
        "required": [
          "data",
          "page"
        ],
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "sites": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Site"
                }
              },
              "metering_points": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/MeteringPoint"
                }
              },
              "delivery_access": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "string",
                    "const": "customer-supply-periods-v1"
                  },
                  "complete": {
                    "type": "boolean",
                    "const": true
                  },
                  "windows": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/DeliveryWindow"
                    }
                  }
                },
                "required": [
                  "version",
                  "complete",
                  "windows"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "sites",
              "metering_points",
              "delivery_access"
            ],
            "additionalProperties": false
          },
          "page": {
            "type": "object",
            "properties": {
              "sites": {
                "$ref": "#/components/schemas/Page"
              }
            },
            "required": [
              "sites"
            ],
            "additionalProperties": false
          }
        }
      },
      "ValuesResponse": {
        "type": "object",
        "required": [
          "data",
          "page"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MeteringValue"
            }
          },
          "page": {
            "$ref": "#/components/schemas/Page"
          }
        }
      }
    }
  }
}
