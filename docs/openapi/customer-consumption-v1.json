              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              },
              "X-Gridex-Consumption-Version": {
                "schema": {
                  "type": "string",
                  "const": "2026-11-13.1"
                }
              }
            }
          },
          "404": {
            "description": "Facility does not belong to the resolved customer.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              },
              "X-Gridex-Consumption-Version": {
                "schema": {
                  "type": "string",
                  "const": "2026-11-13.1"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              },
              "X-Gridex-Consumption-Version": {
                "schema": {
                  "type": "string",
                  "const": "2026-11-13.1"
                }
              }
            }
          },
          "503": {
            "description": "Authority or canonical data unavailable/incomplete; no customer data.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
