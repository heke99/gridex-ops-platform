  "paths": {
    "/api/v1/staff-onboarding/invitations/accept": {
      "post": {
        "operationId": "postApiV1StaffOnboardingInvitationsAccept",
        "x-required-scopes": [
          "staff_users.write"
        ],
        "x-scope-mode": "all",
        "x-rate-limit-class": "write",
        "x-idempotency-required": true,
        "x-cache-policy": "no-store",
        "x-public-id-policy": "opaque-references",
        "summary": "Accept a registered independent staff invitation",
        "description": "Requires the exact active registered API client, verified tenant-owned Auth identity and confirmed email, an active purpose=staff provider, a purpose=staff_invitation_acceptance signed local-subject proof lasting at most 60 seconds and unused JTI. The durable invitation and immutable local-to-central identity binding determine central company, actor and role. Explicit POST only; retry with a fresh assertion and the same Idempotency-Key. API data and canonical authority stay in the registered central OPS project; local Auth stays in the tenant project.",
        "security": [
          {
            "bearerAuth": [],
            "staffAssertion": [],
            "supportAuthToken": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "x-gridex-expected-project-ref",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9]{20}$"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9._:+~-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StaffOnboardingAcceptRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Own invitation accepted. No tenant/customer identifiers or login tokens are returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffOnboardingAcceptResponse"
                }
              }
            }
          },
          "400": {
            "description": "Acceptance refused; response excludes backend details and credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffOnboardingErrorResponse"
                }
              }
            }
          },
          "401": {
