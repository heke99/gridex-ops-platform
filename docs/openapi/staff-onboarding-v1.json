  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Registered API credential; explicit staff_users.read for identity resolution, staff_users.write for invitation acceptance. Wildcards confer neither."
      },
      "staffAssertion": {
        "type": "apiKey",
        "in": "header",
        "name": "x-gridex-staff-assertion",
        "description": "Fresh asymmetric JWT signed by the registered active staff provider; local sub must match remote verified tenant Auth. Company and token_use must match the exact operation: staff_identity_resolution or staff_invitation_acceptance. Lifetime at most 60 seconds; JTI single-use. These proofs never authorize ordinary Staff API operations."
      },
      "supportAuthToken": {
        "type": "apiKey",
        "in": "header",
        "name": "x-gridex-support-auth-token",
        "description": "Tenant-owned Auth access token forwarded only by the portal server and verified with getUser at the exact registered independent Auth URL using a public key. Never central OPS service Auth, browser-selected URLs, logged or returned."
      }
    },
    "schemas": {
      "StaffOnboardingAcceptRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "invitation_token"
        ],
        "properties": {
          "invitation_token": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          }
        }
      },
      "StaffOnboardingAcceptResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "request_id",
          "contract_schema_version"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "accepted"
                ]
              }
            }
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "contract_schema_version": {
            "type": "string",
            "enum": [
              "2026-10-05.2"
            ]
          }
        }
      },
      "StaffOnboardingErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "request_id",
          "contract_schema_version"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "contract_schema_version": {
            "type": "string",
            "enum": [
              "2026-10-05.2"
            ]
          }
        }
      },
      "StaffIdentityResolveRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "StaffIdentityResolveResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "request_id",
          "contract_schema_version"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "actor_user_id",
              "binding_id",
              "binding_version"
            ],
            "properties": {
              "actor_user_id": {
                "type": "string",
                "format": "uuid"
              },
              "binding_id": {
                "type": "string",
                "format": "uuid"
              },
              "binding_version": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "contract_schema_version": {
            "type": "string",
            "enum": [
              "2026-10-05.2"
            ]
          }
        }
      }
    }
  }
