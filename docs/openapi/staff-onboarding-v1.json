              }
            }
          }
        }
      }
    },
    "/api/v1/openapi/staff-onboarding-v1.json": {
      "get": {
        "operationId": "getApiV1OpenapiStaffOnboardingV1Json",
        "x-required-scopes": [],
        "x-scope-mode": "all",
        "x-rate-limit-class": "read",
        "x-idempotency-required": false,
        "x-cache-policy": "private-revalidate",
        "x-public-id-policy": "none",
        "summary": "Read the independent onboarding contract",
        "security": [],
        "responses": {
          "200": {
            "description": "This independent contract is separate from frozen Staff API 2026-10-04.1.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "description": "Unchanged contract document"
          }
        }
      }
    },
    "/api/v1/staff-onboarding/identity/resolve": {
      "post": {
        "operationId": "postApiV1StaffOnboardingIdentityResolve",
        "x-required-scopes": [
          "staff_users.read"
        ],
        "x-scope-mode": "all",
        "x-rate-limit-class": "read",
        "x-idempotency-required": false,
        "x-cache-policy": "no-store",
        "x-public-id-policy": "staff-identities-and-opaque-references",
        "summary": "Resolve a verified independent tenant staff identity",
        "description": "Verifies the local user through the registered tenant-owned public-key Auth client, then a fresh purpose=staff_identity_resolution local-subject asymmetric assertion with company binding and unused JTI. Returns only an existing immutable current binding to the central OPS actor. Never creates Auth accounts, memberships, roles or bindings and never matches users by email or equal UUID. Subsequent Staff API assertions retain central actor sub and must carry the returned binding ID/version plus verified local identity claims.",
        "security": [
          {
            "bearerAuth": [],
            "staffAssertion": [],
            "supportAuthToken": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "x-gridex-expected-project-ref",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9]{20}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StaffIdentityResolveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current independent identity binding resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffIdentityResolveResponse"
                }
              }
            }
          },
          "400": {
            "description": "Identity resolution refused without credentials or backend details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffOnboardingErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Identity resolution refused without credentials or backend details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffOnboardingErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Identity resolution refused without credentials or backend details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffOnboardingErrorResponse"
                }
              }
            }
          },
          "405": {
            "description": "Identity resolution refused without credentials or backend details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffOnboardingErrorResponse"
                }
              }
            }
