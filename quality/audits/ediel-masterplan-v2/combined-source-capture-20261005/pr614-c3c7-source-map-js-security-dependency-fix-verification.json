      "portable_script_source": "const assert = require('node:assert/strict');\nconst { createRequire } = require('node:module');\nconst path = require('node:path');\nconst fs = require('node:fs');\nconst { SourceMapGenerator, SourceMapConsumer } = require('source-map-js');\nconst postcss = require('postcss');\nconst postcssRequire = createRequire(require.resolve('postcss'));\nconst sourceMapVersion = require('source-map-js/package.json').version;\nassert.equal(sourceMapVersion, '1.2.2');\nassert.equal(postcssRequire('source-map-js/package.json').version, '1.2.2');\nassert.equal(require('postcss/package.json').version, '8.5.25');\n\nconst generator = new SourceMapGenerator({ file: 'input.css' });\ngenerator.addMapping({ generated: { line: 1, column: 0 }, original: { line: 7, column: 2 }, source: 'input-original.css' });\ngenerator.setSourceContent('input-original.css', '\\n\\n\\n\\n\\n\\na { color: red; }');\nconst basicMap = generator.toJSON();\nconst indexed = (line, column, map = basicMap) => ({ version: 3, sections: [{ offset: { line, column }, map }] });\nconst results = [];\nfunction control(name, execute) {\n  execute();\n  results.push({ name, result: 'PASS' });\n}\n\nfor (const field of ['line', 'column']) {\n  for (const [label, value] of [['negative', -1], ['fraction', 0.5], ['nan', NaN], ['infinity', Infinity], ['string', '1'], ['null', null], ['unsafe-integer', Number.MAX_SAFE_INTEGER + 1]]) {\n    control(`reject-${field}-${label}`, () => {\n      assert.throws(() => new SourceMapConsumer(indexed(field === 'line' ? value : 0, field === 'column' ? value : 0)), /Section offset line and column must be non-negative integers\\./);\n    });\n  }\n}\ncontrol('reject-flat-line-amplification', () => assert.throws(() => new SourceMapConsumer(indexed(10000001, 0)), /Section offset line must not exceed 10000000\\./));\ncontrol('reject-nested-line-amplification', () => assert.throws(() => new SourceMapConsumer(indexed(6000000, 0, indexed(6000000, 0))), /including offsets of nested sections\\./));\ncontrol('reject-out-of-order-sections', () => assert.throws(() => new SourceMapConsumer({ version: 3, sections: [{ offset: { line: 2, column: 0 }, map: basicMap }, { offset: { line: 1, column: 0 }, map: basicMap }] }), /Section offsets must be ordered and non-overlapping\\./));\ncontrol('valid-basic-map-roundtrip', () => {\n  const consumer = new SourceMapConsumer(basicMap);\n  assert.deepEqual(consumer.originalPositionFor({ line: 1, column: 0 }), { source: 'input-original.css', line: 7, column: 2, name: null });\n  assert.equal(consumer.sourceContentFor('input-original.css'), '\\n\\n\\n\\n\\n\\na { color: red; }');\n  assert.deepEqual(new SourceMapConsumer(SourceMapGenerator.fromSourceMap(consumer).toJSON()).originalPositionFor({ line: 1, column: 0 }), consumer.originalPositionFor({ line: 1, column: 0 }));\n});\ncontrol('valid-indexed-map-consumer', () => {\n  const consumer = new SourceMapConsumer(indexed(2, 0));\n  const mappings = [];\n  consumer.eachMapping(mapping => mappings.push(mapping));\n  assert.equal(mappings.length, 1);\n  assert.equal(mappings[0].generatedLine, 3);\n  assert.equal(mappings[0].originalLine, 7);\n  assert.equal(mappings[0].source, 'input-original.css');\n  assert.deepEqual(consumer.originalPositionFor({ line: 3, column: 1 }), { source: 'input-original.css', line: 7, column: 2, name: null });\n});\n\nconst plugin = { postcssPlugin: 'pr614-affected-dependency-control', Declaration(decl) { if (decl.prop === 'color') decl.value = 'blue'; } };\ncontrol('postcss-transform-and-generated-map', () => {\n  const result = postcss([plugin]).process('a { color: red; }', { from: 'input.css', to: 'output.css', map: { inline: false, annotation: false } });\n  assert.equal(result.css, 'a { color: blue; }');\n  assert.ok(result.map);\n  const original = new SourceMapConsumer(result.map.toJSON()).originalPositionFor({ line: 1, column: 0 });\n  assert.equal(original.source, 'input.css');\n  assert.equal(original.line, 1);\n});\ncontrol('postcss-valid-previous-map-integration', () => {\n  const result = postcss([plugin]).process('a { color: red; }', { from: 'input.css', to: 'output.css', map: { inline: false, annotation: false, prev: basicMap } });\n  assert.equal(result.css, 'a { color: blue; }');\n  const original = new SourceMapConsumer(result.map.toJSON()).originalPositionFor({ line: 1, column: 0 });\n  assert.equal(original.source, 'input-original.css');\n  assert.equal(original.line, 7);\n  assert.equal(original.column, 2);\n});\ncontrol('postcss-rejects-amplifying-indexed-previous-map', () => {\n  assert.throws(() => postcss([plugin]).process('a { color: red; }', { from: 'input.css', to: 'output.css', map: { inline: false, annotation: false, prev: indexed(10000001, 0) } }).css, /Section offset line must not exceed 10000000\\./);\n});\n\nconst output = { node: process.version, source_map_js: sourceMapVersion, postcss: require('postcss/package.json').version, postcss_source_map_resolution: postcssRequire.resolve('source-map-js'), isolated_root: __dirname, controls_passed: results.length, failed: 0, controls: results };\nconst destination = path.join(__dirname, 'affected-controls-result.json');\nfs.writeFileSync(destination, JSON.stringify(output, null, 2) + '\\n', { flag: 'wx' });\nprocess.stdout.write(JSON.stringify(output, null, 2) + '\\n');\n"
    },
