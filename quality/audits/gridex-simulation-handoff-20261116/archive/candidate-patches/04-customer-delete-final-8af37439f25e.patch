+DECLARE
+  old_proc jsonb;
+  new_proc jsonb;
+  old_acl jsonb;
+  new_acl jsonb;
+BEGIN
+  SELECT to_jsonb(p) INTO STRICT old_proc FROM pg_proc p
+  WHERE p.oid = 'public.gridex_delete_test_customer_v1(uuid,uuid,uuid)'::regprocedure;
+  IF md5(old_proc->>'prosrc') = 'b9dd0ed9061fede142be556cb4984be3' THEN
+    RETURN; -- Exact body already installed; no DML or metadata write on replay.
+  END IF;
+  IF md5(old_proc->>'prosrc') <> 'b6da43220109e6cd6a14eafc451926af' THEN
+    RAISE EXCEPTION 'test_customer_delete_exact_preimage_required';
+  END IF;
+  SELECT jsonb_agg(to_jsonb(a) ORDER BY a.grantor,a.grantee,a.privilege_type,a.is_grantable)
+    INTO old_acl
+  FROM aclexplode(coalesce((SELECT proacl FROM pg_proc WHERE oid=(old_proc->>'oid')::oid),
+                          acldefault('f',(old_proc->>'proowner')::oid))) a;
+  EXECUTE $definition$CREATE OR REPLACE FUNCTION public.gridex_delete_test_customer_v1(p_company_id uuid, p_customer_id uuid, p_actor_user_id uuid)
+ RETURNS jsonb
