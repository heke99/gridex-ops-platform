+      select 1 from public.customer_sites s
+      where s.id = a.customer_site_id
+        and s.company_id = p_company_id and s.customer_id = p_customer_id
+    ))
+    and (a.metering_point_id is null or exists (
+      select 1 from public.metering_points m
+      where m.id = a.metering_point_id
+        and m.company_id = p_company_id and m.customer_id = p_customer_id
+    ))
+    and not exists (
+      select 1 from public.customer_onboarding_legal_snapshots l
+      where l.customer_id = p_customer_id
+         or l.onboarding_operation_id = a.onboarding_operation_id
+    );
