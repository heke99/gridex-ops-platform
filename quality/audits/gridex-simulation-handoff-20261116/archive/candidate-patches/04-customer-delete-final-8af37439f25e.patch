+++ b/scripts/test-customer-delete-onboarding-regression.sql
@@ -0,0 +1,342 @@
+-- Rollback-only actual-RPC/schema component regression. Requires legitimate service context.
+-- Actor existence and both TEST companies must be bound by producer admin READONLY before execution.
+-- No JWT/auth claims/SET ROLE. This is not normal-UI/Auth or scenario approval.
+\set ON_ERROR_STOP on
+\if :{?clone_database}
+\else
+  \echo 'STOP: clone_database is required'
+  \quit 3
+\endif
+\if :{?company_id}
+\else
+  \echo 'STOP: company_id is required'
+  \quit 3
+\endif
+\if :{?other_company_id}
+\else
+  \echo 'STOP: other_company_id is required'
+  \quit 3
+\endif
+\if :{?actor_user_id}
+\else
+  \echo 'STOP: actor_user_id is required'
+  \quit 3
+\endif
+BEGIN;
+SET LOCAL statement_timeout='8s';
+SET LOCAL lock_timeout='2s';
+CREATE TEMP TABLE delete_regression_input ON COMMIT DROP AS
+SELECT :'clone_database'::text AS database_name, :'company_id'::uuid AS company_id,
+       :'other_company_id'::uuid AS other_company_id, :'actor_user_id'::uuid AS actor_user_id,
+       null::uuid AS foreign_contract_id;
+DO $regression$
+DECLARE
+  component_report jsonb;
+  v_input record;
+  v_variant text;
+  v_customer_id uuid;
+  v_foreign_customer_id uuid;
+  v_operation_id uuid;
+  v_foreign_operation_id uuid;
+  v_application_id uuid;
+  v_extra_application_id uuid;
+  v_site_id uuid;
+  v_point_id uuid;
+  v_expected_state text;
+  v_actual_state text;
+  v_reply jsonb;
+  v_operation_before jsonb;
+  v_applications_before jsonb;
+  v_legal_before jsonb;
+  v_audit_before bigint;
+  v_passed integer := 0;
+  v_rpc_calls integer := 0;
+  v_fk_checks integer := 0;
+  v_skipped integer := 0;
+  v_contract_fixture_error text;
+  v_fixture jsonb;
+  v_expected_fixture jsonb;
+  v_cases jsonb := '[]'::jsonb;
+  v_graph_before jsonb;
+  v_graph_after jsonb;
+  v_fk_before jsonb;
+  v_error_message text;
+BEGIN
+  SELECT * INTO STRICT v_input FROM delete_regression_input;
+  IF current_database() <> v_input.database_name OR v_input.database_name = 'postgres'
+     OR v_input.database_name NOT LIKE 'gridex_%' THEN
+    RAISE EXCEPTION 'explicit_owned_clone_required';
+  END IF;
+  -- Do not manufacture this context. Ordinary SQL-owner execution without it stops.
+  IF auth.role() IS DISTINCT FROM 'service_role' THEN
+    RAISE EXCEPTION 'existing_legitimate_service_role_context_required' USING ERRCODE='42501';
+  END IF;
+  IF v_input.company_id = v_input.other_company_id
+     OR (SELECT count(*) FROM public.companies
+         WHERE id IN (v_input.company_id,v_input.other_company_id)
+           AND operating_environment = 'test') <> 2
+ THEN
+    RAISE EXCEPTION 'current_owned_test_fixture_bindings_required';
+  END IF;
+  IF has_function_privilege('authenticated','public.gridex_delete_test_customer_v1(uuid,uuid,uuid)','EXECUTE')
+     OR has_function_privilege('anon','public.gridex_delete_test_customer_v1(uuid,uuid,uuid)','EXECUTE')
+     OR NOT has_function_privilege('service_role','public.gridex_delete_test_customer_v1(uuid,uuid,uuid)','EXECUTE') THEN
+    RAISE EXCEPTION 'delete_rpc_acl_changed';
+  END IF;
+  FOREACH v_variant IN ARRAY ARRAY[
+    'positive','protected_history','not_test','wrong_tenant','non_admin','wrong_source','not_committed',
+    'operation_not_completed','operation_channel','result_customer','result_application',
+    'result_operation','result_legal','foreign_site','foreign_point','contract',
+    'legal_customer','legal_operation','remaining_application_rollback',
+    'foreign_operation_company','foreign_customer_company_fk'
+  ] LOOP
+    v_customer_id:=gen_random_uuid(); v_foreign_customer_id:=gen_random_uuid();
+    v_operation_id:=gen_random_uuid(); v_foreign_operation_id:=gen_random_uuid();
+    v_application_id:=gen_random_uuid(); v_site_id:=gen_random_uuid(); v_point_id:=gen_random_uuid();
+    -- Component fixtures only; canonical numbering is left to the existing defaults/triggers.
+    INSERT INTO public.customers(id,company_id,name,full_name,customer_type,status,is_test_data,source,created_by,updated_by)
+    VALUES(v_customer_id,v_input.company_id,'Delete regression','Delete regression','private','draft',true,'admin_customer_intake',v_input.actor_user_id,v_input.actor_user_id),
+          (v_foreign_customer_id,v_input.company_id,'Other delete regression','Other delete regression','private','draft',true,'admin_customer_intake',v_input.actor_user_id,v_input.actor_user_id);
+    INSERT INTO public.customer_onboarding_operations(id,company_id,channel,idempotency_key,correlation_id,status,command_snapshot,result_snapshot,completed_at)
+    VALUES(v_operation_id,v_input.company_id,'admin',v_operation_id::text,gen_random_uuid(),'completed',
+      jsonb_build_object('regression',v_variant),jsonb_build_object('ok',true,'code','customer_onboarding_committed',
+      'operation_id',v_operation_id,'customer_id',v_customer_id,'application_id',v_application_id,'legal_snapshot_id',null),now()),
+      (v_foreign_operation_id,CASE WHEN v_variant='foreign_operation_company' THEN v_input.other_company_id ELSE v_input.company_id END,
+       'admin',v_foreign_operation_id::text,gen_random_uuid(),'completed','{}','{}',now());
+    INSERT INTO public.customer_onboarding_applications(id,company_id,onboarding_operation_id,customer_id,channel,source_record_type,status)
+    VALUES(v_application_id,v_input.company_id,v_operation_id,v_customer_id,'admin','admin_customer_intake','committed');
+    v_expected_state:='23503';
+    CASE v_variant
+      WHEN 'positive' THEN v_expected_state:=NULL;
+      WHEN 'protected_history' THEN
+        INSERT INTO public.customer_blockers(company_id,customer_id,blocker_type,title)
+        VALUES(v_input.company_id,v_customer_id,'regression','Protected test history');
+        v_expected_state:='23514';
+      WHEN 'not_test' THEN
+        UPDATE public.customers SET is_test_data=false WHERE id=v_customer_id;
+        v_expected_state:='23514';
+      WHEN 'wrong_tenant' THEN v_expected_state:='P0002';
+      WHEN 'non_admin' THEN UPDATE public.customer_onboarding_applications SET channel='website' WHERE id=v_application_id;
+      WHEN 'wrong_source' THEN UPDATE public.customer_onboarding_applications SET source_record_type='website_application' WHERE id=v_application_id;
+      WHEN 'not_committed' THEN UPDATE public.customer_onboarding_applications SET status='pending' WHERE id=v_application_id;
+      WHEN 'operation_not_completed' THEN UPDATE public.customer_onboarding_operations SET status='started' WHERE id=v_operation_id;
+      WHEN 'operation_channel' THEN UPDATE public.customer_onboarding_operations SET channel='website' WHERE id=v_operation_id;
+      WHEN 'result_customer' THEN UPDATE public.customer_onboarding_operations SET result_snapshot=jsonb_set(result_snapshot,'{customer_id}',to_jsonb(v_foreign_customer_id)) WHERE id=v_operation_id;
+      WHEN 'result_application' THEN UPDATE public.customer_onboarding_operations SET result_snapshot=jsonb_set(result_snapshot,'{application_id}',to_jsonb(gen_random_uuid())) WHERE id=v_operation_id;
+      WHEN 'result_operation' THEN UPDATE public.customer_onboarding_operations SET result_snapshot=jsonb_set(result_snapshot,'{operation_id}',to_jsonb(v_foreign_operation_id)) WHERE id=v_operation_id;
+      WHEN 'result_legal' THEN UPDATE public.customer_onboarding_operations SET result_snapshot=jsonb_set(result_snapshot,'{legal_snapshot_id}',to_jsonb(gen_random_uuid())) WHERE id=v_operation_id;
+      WHEN 'foreign_site' THEN
+        INSERT INTO public.customer_sites(id,company_id,customer_id,site_name,site_type,status,country)
+        VALUES(v_site_id,v_input.company_id,v_foreign_customer_id,'Other site','consumption','draft','SE');
+        UPDATE public.customer_onboarding_applications SET customer_site_id=v_site_id WHERE id=v_application_id;
+      WHEN 'foreign_point' THEN
+        INSERT INTO public.customer_sites(id,company_id,customer_id,site_name,site_type,status,country)
+        VALUES(v_site_id,v_input.company_id,v_foreign_customer_id,'Other site','consumption','draft','SE');
+        INSERT INTO public.metering_points(id,company_id,customer_id,site_id,metering_point_id,reading_frequency,measurement_type,is_settlement_relevant,status)
+        VALUES(v_point_id,v_input.company_id,v_foreign_customer_id,v_site_id,'735999'||lpad((abs(hashtext(v_point_id::text)::bigint)%1000000000000)::text,12,'0'),'monthly','consumption',true,'draft');
+        UPDATE public.customer_onboarding_applications SET metering_point_id=v_point_id WHERE id=v_application_id;
+      WHEN 'contract' THEN
+        -- Explicit rollback-only component fixture, never a claimed existing/signed agreement.
+        v_input.foreign_contract_id:=gen_random_uuid();
+        BEGIN
+          INSERT INTO public.customer_contracts(id,company_id,customer_id,source_type,status,contract_name,contract_type,metadata)
+          VALUES(v_input.foreign_contract_id,v_input.company_id,v_foreign_customer_id,
+            'system','draft','Rollback-only DELETE FK component','variable_monthly',
+            jsonb_build_object('source','rollback_only_delete_fk_component'));
+        EXCEPTION WHEN OTHERS THEN
+          v_contract_fixture_error:=SQLSTATE;
+          v_skipped:=v_skipped+1;
+          v_cases:=v_cases||jsonb_build_array(jsonb_build_object('case',v_variant,
+            'kind','NOTRUN_FIXTURE_REJECTED','fixtureSQLState',v_contract_fixture_error));
+          CONTINUE; -- Explicit NOTRUN; never counted as a passed negative or RPC call.
+        END;
+        UPDATE public.customer_onboarding_applications SET contract_id=v_input.foreign_contract_id WHERE id=v_application_id;
+      WHEN 'legal_customer' THEN
+        INSERT INTO public.customer_onboarding_legal_snapshots(company_id,onboarding_operation_id,customer_id,content_hash)
+        VALUES(v_input.company_id,v_foreign_operation_id,v_customer_id,repeat('a',64));
+      WHEN 'legal_operation' THEN
+        INSERT INTO public.customer_onboarding_legal_snapshots(company_id,onboarding_operation_id,customer_id,content_hash)
+        VALUES(v_input.company_id,v_operation_id,v_foreign_customer_id,repeat('b',64));
+      WHEN 'remaining_application_rollback' THEN
+        v_extra_application_id:=gen_random_uuid();
+        INSERT INTO public.customer_onboarding_applications(id,company_id,onboarding_operation_id,customer_id,channel,source_record_type,status)
+        VALUES(v_extra_application_id,v_input.company_id,v_foreign_operation_id,v_customer_id,'website','website_application','committed');
+      WHEN 'foreign_operation_company' THEN
+        -- Deliberately invalid cross-company component link, allowed by the actual single-column FK.
+        -- All other disposable-capsule predicates match, so this isolates operation.company_id.
+        UPDATE public.customer_onboarding_operations
+        SET result_snapshot=jsonb_build_object('ok',true,'code','customer_onboarding_committed',
+          'operation_id',v_foreign_operation_id,'customer_id',v_customer_id,
+          'application_id',v_application_id,'legal_snapshot_id',null)
+        WHERE id=v_foreign_operation_id;
+        UPDATE public.customer_onboarding_applications SET onboarding_operation_id=v_foreign_operation_id WHERE id=v_application_id;
+      WHEN 'foreign_customer_company_fk' THEN NULL;
+    END CASE;
+    SELECT jsonb_build_object(
+      'customerCompanyOwn',c.company_id=v_input.company_id,
+      'customerTest',c.is_test_data,'customerSource',c.source,
+      'applicationCompanyOwn',a.company_id=v_input.company_id,
+      'applicationCustomerOwn',a.customer_id=v_customer_id,
