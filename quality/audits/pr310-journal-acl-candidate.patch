+# These are the explicit PostgreSQL17 ALL TABLE privileges in the admitted
+# managed bootstrap. This models the historical creation boundary only; it is
+# not approval of final journal authorization or current production access.
+MANAGED_TABLE_PRIVILEGES = (
+    "DELETE", "INSERT", "MAINTAIN", "REFERENCES",
+    "SELECT", "TRIGGER", "TRUNCATE", "UPDATE",
+)
+MANAGED_JOURNAL_ACL = tuple(
+    (role, privilege, False, "postgres")
+    for role in ("anon", "authenticated", "postgres", "service_role")
+    for privilege in MANAGED_TABLE_PRIVILEGES
+)
+
+
+def journal_acl_oracle_sql() -> str:
+    # Do not derive the expected set from pg_default_acl or the actual table: a
+    # wrong grant would then validate itself. Normalize names, grantor and grant
+    # option independently of ACL array order / role OIDs. NULL still resolves
+    # to built-in defaults, which must fail this managed-fixture expectation.
+    grantee = "case when a.grantee=0 then 'PUBLIC' else pg_get_userbyid(a.grantee)::text end"
+    return check(f"""exists(select 1 from pg_class c
+      where c.oid='public.platform_session_revocations'::regclass
+        and c.relkind='r' and c.relpersistence='p'
+        and (select coalesce(jsonb_agg(
+          jsonb_build_array({grantee},a.privilege_type,a.is_grantable,pg_get_userbyid(a.grantor)::text)
+          order by ({grantee}) collate "C",a.privilege_type collate "C",
+            a.is_grantable,pg_get_userbyid(a.grantor)::text collate "C"),'[]'::jsonb)
+          from aclexplode(coalesce(c.relacl,acldefault('r',c.relowner))) a)
+          ={q(json.dumps(MANAGED_JOURNAL_ACL))}::jsonb
+        and not exists(select 1 from pg_attribute col
+          where col.attrelid=c.oid and col.attnum>0 and not col.attisdropped
+            and col.attacl is not null))""",
+      "6D2 journal exact managed table ACL/grantor/grant-option/no column ACL")
+
+
