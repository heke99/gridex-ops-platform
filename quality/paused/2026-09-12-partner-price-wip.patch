+    expect(fixture.state.calls).toHaveLength(0)
+    expect(requireIntegrationApiAccess).toHaveBeenCalledWith(expect.any(NextRequest), { anyOf: ['website_quotes.write', 'customer_contracts.read', 'partner_contracts.write'] })
+  })
+  it('persists one result and returns exactly the stored public body on replay', async () => {
+    const first = await invoke()
+    const payload = await first.json()
+    expect(first.status).toBe(200); expect(first.headers.get('Idempotency-Replayed')).toBe('false')
+    const second = await invoke(body, 'partner-price-request-01', 'request-retry')
+    expect(second.status).toBe(200); expect(second.headers.get('Idempotency-Replayed')).toBe('true')
+    expect(second.headers.get('X-Request-ID')).toBe('request-retry')
+    expect(await second.json()).toEqual(payload)
+    expect(resolveEnergyContext).toHaveBeenCalledTimes(1); expect(calculateOfferQuote).toHaveBeenCalledTimes(1)
+    expect(fixture.state.rows[0]).toMatchObject({ company_id: 'company-A', api_client_id: 'client-A', route: '/api/partner/v1/price', status: 'completed', response_status: 200, response_body: payload })
+    expect(fixture.state.calls.filter((call) => call.op === 'update')).toEqual([expect.objectContaining({ filters: { id: 'claim-1', company_id: 'company-A', status: 'processing' } })])
