+import { NextRequest } from 'next/server'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+type Row = Record<string, unknown>
+const fixture = vi.hoisted(() => {
+  const state = {
+    company: 'company-A', client: 'client-A', denied: false,
+    rows: [] as Row[], calls: [] as Array<{ op: string; payload?: Row; filters?: Row }>,
+    claimsUnavailable: false, completionUnavailable: false, completionUncertain: false,
+    resolverError: false, quoteError: false, waitForQuote: null as Promise<void> | null,
+    quoteStarted: null as (() => void) | null, quoteCount: 0,
+  }
+  const from = vi.fn((table: string) => {
+    if (table !== 'integration_api_write_idempotency') throw new Error(`Unexpected table: ${table}`)
+    let op = 'select'
+    let payload: Row = {}
+    const filters: Row = {}
+    const execute = async () => {
+      state.calls.push({ op, payload: structuredClone(payload), filters: { ...filters } })
+      if (op === 'insert') {
+        if (state.claimsUnavailable) return { data: null, error: { code: '08006' } }
+        const same = state.rows.find((row) => ['company_id', 'api_client_id', 'route', 'idempotency_key'].every((key) => row[key] === payload[key]))
+        if (same) return { data: null, error: { code: '23505' } }
+        const row = { ...payload, id: `claim-${state.rows.length + 1}` }
+        state.rows.push(row)
+        return { data: { id: row.id }, error: null }
+      }
+      const row = state.rows.find((candidate) => Object.entries(filters).every(([key, value]) => candidate[key] === value))
+      if (op === 'update' && row) {
+        if (payload.status === 'completed' && state.completionUnavailable) return { data: null, error: { code: '08006' } }
+        Object.assign(row, structuredClone(payload))
+        if (payload.status === 'completed' && state.completionUncertain) return { data: null, error: { code: '08006' } }
+      }
+      return { data: row ? structuredClone(row) : null, error: null }
+    }
+    const query = {
+      insert(value: Row) { op = 'insert'; payload = value; return query },
+      update(value: Row) { op = 'update'; payload = value; return query },
+      select() { return query },
+      eq(key: string, value: unknown) { filters[key] = value; return query },
+      maybeSingle: execute,
+      then: <TResult1 = Awaited<ReturnType<typeof execute>>, TResult2 = never>(
+        onfulfilled?: ((value: Awaited<ReturnType<typeof execute>>) => TResult1 | PromiseLike<TResult1>) | null,
+        onrejected?: ((reason: unknown) => TResult2 | PromiseLike<TResult2>) | null,
+      ) => execute().then(onfulfilled, onrejected),
+    }
+    return query
+  })
+  return { state, from }
+})
+
+vi.mock('@/lib/supabase/service', () => ({ supabaseService: { from: fixture.from } }))
+vi.mock('@/lib/integrations/apiAuth', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('@/lib/integrations/apiAuth')>()
+  return {
+    ...actual,
+    requireIntegrationApiAccess: vi.fn(async () => fixture.state.denied
+      ? { ok: false, status: 403, error: 'Denied', errorCode: 'scope_missing' }
+      : { ok: true, client: {
+        id: fixture.state.client, company_id: fixture.state.company,
+        metadata: { partner_default_offer_reference: 'offer-fixture' },
+      } }),
+    logIntegrationApiRequest: vi.fn(async () => undefined),
+  }
+})
+vi.mock('@/lib/energy/resolver', () => ({
+  resolveEnergyContext: vi.fn(async () => {
+    if (fixture.state.resolverError) throw new Error('Resolution unavailable')
+    return {
+      resolutionId: 'resolution-fixture', priceArea: 'SE3', resolutionStatus: 'resolved',
+      priceAreaAssurance: { status: 'verified', confidence: 1, source: 'grid_owner' },
+      gridAreaCode: 'ABC', gridAreaName: 'Test area', gridOwnerName: 'Test owner', gridOwnerId: 'owner-fixture',
+      confidence: 1, warnings: [], sourceChain: ['fixture'],
+    }
+  }),
+}))
+vi.mock('@/lib/pricing/offerQuote', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('@/lib/pricing/offerQuote')>()
+  return { ...actual, calculateOfferQuote: vi.fn(async () => {
+    const count = ++fixture.state.quoteCount
+    fixture.state.quoteStarted?.()
+    if (fixture.state.waitForQuote) await fixture.state.waitForQuote
+    if (fixture.state.quoteError) throw new Error('Persistence response lost')
+    return {
+      quote_reference: `quote_fixture_${count}`, valid_until: '2026-09-13T12:00:00Z',
+      offer: { public_name: 'Test tariff', product_code: 'test-tariff', contract_type: 'fixed' },
+      estimate: { monthly_ex_vat: 100, monthly_vat: 25, monthly_inc_vat: 125, annual_ex_vat: 1200, annual_vat: 300, annual_inc_vat: 1500 },
+      lines: [], warnings: [], assumptions: [],
+    }
+  }) }
+})
