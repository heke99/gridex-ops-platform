{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "plugins": [],
    "tsBuildInfoFile": ".next/cache/tsconfig.app.tsbuildinfo"
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
